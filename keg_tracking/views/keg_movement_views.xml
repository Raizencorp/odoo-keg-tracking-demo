<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="keg_movement_view_list" model="ir.ui.view">
        <field name="name">keg.movement.list</field>
        <field name="model">keg.movement</field>
        <field name="arch" type="xml">
            <list string="Keg Movements" create="0" edit="0" delete="0"
                  decoration-success="movement_type == 'return'"
                  decoration-info="movement_type == 'dispatch'"
                  decoration-danger="movement_type == 'lost'"
                  decoration-muted="movement_type in ('clean', 'retire')">
                <field name="date"/>
                <field name="keg_id"/>
                <field name="type_id" optional="hide"/>
                <field name="movement_type" widget="badge"
                       decoration-info="movement_type == 'dispatch'"
                       decoration-success="movement_type == 'return'"
                       decoration-danger="movement_type == 'lost'"
                       decoration-warning="movement_type == 'maintenance'"/>
                <field name="product_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="move_id" optional="show" groups="account.group_account_invoice"/>
                <field name="note" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="keg_movement_view_pivot" model="ir.ui.view">
        <field name="name">keg.movement.pivot</field>
        <field name="model">keg.movement</field>
        <field name="arch" type="xml">
            <pivot string="Keg Movements" sample="1">
                <field name="date" interval="month" type="col"/>
                <field name="movement_type" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="keg_movement_view_graph" model="ir.ui.view">
        <field name="name">keg.movement.graph</field>
        <field name="model">keg.movement</field>
        <field name="arch" type="xml">
            <graph string="Keg Movements" type="bar" sample="1">
                <field name="date" interval="week"/>
                <field name="movement_type"/>
            </graph>
        </field>
    </record>

    <record id="keg_movement_view_search" model="ir.ui.view">
        <field name="name">keg.movement.search</field>
        <field name="model">keg.movement</field>
        <field name="arch" type="xml">
            <search string="Keg Movements">
                <field name="keg_id"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <filter string="Dispatches" name="filter_dispatch" domain="[('movement_type', '=', 'dispatch')]"/>
                <filter string="Returns" name="filter_return" domain="[('movement_type', '=', 'return')]"/>
                <filter string="Losses" name="filter_lost" domain="[('movement_type', '=', 'lost')]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="date"/>
                <group expand="0" string="Group By">
                    <filter string="Operation" name="groupby_type" context="{'group_by': 'movement_type'}"/>
                    <filter string="Customer" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Beer" name="groupby_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Keg Type" name="groupby_keg_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_keg_movement" model="ir.actions.act_window">
        <field name="name">Keg Movements</field>
        <field name="res_model">keg.movement</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No keg movement yet</p>
            <p>Every fill, dispatch, return and cleaning is logged here automatically.</p>
        </field>
    </record>
</odoo>
