<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="keg_fill_wizard_view_form" model="ir.ui.view">
        <field name="name">keg.fill.wizard.form</field>
        <field name="model">keg.fill.wizard</field>
        <field name="arch" type="xml">
            <form string="Fill Kegs">
                <group>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="keg_type_id" invisible="not product_id"/>
                    <field name="scan" placeholder="Scan a keg serial…" invisible="not product_id"/>
                </group>
                <field name="keg_ids" invisible="not product_id" options="{'no_create': True}">
                    <list>
                        <field name="name"/>
                        <field name="type_id"/>
                        <field name="fill_count"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Fill Kegs" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_keg_fill_wizard" model="ir.actions.act_window">
        <field name="name">Fill Kegs</field>
        <field name="res_model">keg.fill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
