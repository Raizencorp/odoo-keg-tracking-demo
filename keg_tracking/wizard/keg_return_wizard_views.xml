<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="keg_return_wizard_view_form" model="ir.ui.view">
        <field name="name">keg.return.wizard.form</field>
        <field name="model">keg.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Kegs">
                <group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}" placeholder="Scan a keg to select its customer"/>
                        <field name="scan" placeholder="Scan the returned kegs…"/>
                    </group>
                    <group>
                        <field name="held_count" invisible="not partner_id"/>
                        <field name="refund_deposit"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="deposit_total" invisible="not refund_deposit"/>
                    </group>
                </group>
                <field name="keg_ids" options="{'no_create': True}">
                    <list>
                        <field name="name"/>
                        <field name="type_id"/>
                        <field name="partner_id"/>
                        <field name="dispatch_date"/>
                        <field name="days_at_customer" string="Days Out"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="deposit_amount_held"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Register Return" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_keg_return_wizard" model="ir.actions.act_window">
        <field name="name">Return Kegs</field>
        <field name="res_model">keg.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
