<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="keg_lost_wizard_view_form" model="ir.ui.view">
        <field name="name">keg.lost.wizard.form</field>
        <field name="model">keg.lost.wizard</field>
        <field name="arch" type="xml">
            <form string="Declare Kegs Lost">
                <div class="alert alert-warning" role="alert">
                    Lost kegs leave the active fleet. The deposit already charged is retained and,
                    if selected, the customer is invoiced the difference up to the replacement value.
                </div>
                <group>
                    <group>
                        <field name="reason" placeholder="e.g. Customer closed down, kegs not found on site"/>
                        <field name="charge_customer"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="charge_total" invisible="not charge_customer"/>
                    </group>
                </group>
                <field name="keg_ids" options="{'no_create': True}">
                    <list>
                        <field name="name"/>
                        <field name="type_id"/>
                        <field name="partner_id"/>
                        <field name="dispatch_date"/>
                        <field name="days_at_customer" string="Days Out"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="deposit_amount_held"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Declare Lost" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
